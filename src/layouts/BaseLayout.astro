---
// Document shell and the styles every part of the page shares: colour
// tokens, resets, headline typography and the small vocabulary used inside
// scenes and the menu (.eyebrow, .text-link, .keywords).
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="theme-color" content="#070b10" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="manifest" href="/manifest.json" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600&display=swap"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--ink: #070b10;
		--paper: #eeeae1;
		--accent: #ddbc80;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 0;
	}

	body {
		margin: 0;
		background: var(--ink);
		color: var(--paper);
		font-family: Manrope, Arial, sans-serif;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	h1,
	h2 {
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 1.07;
		margin: 0 0 28px;
		font-size: clamp(44px, 5.5vw, 86px);
	}

	h2 {
		font-size: clamp(40px, 4.6vw, 72px);
	}

	em {
		font-family: Georgia, serif;
		font-weight: 400;
		color: var(--accent);
	}

	.eyebrow {
		font-family: "Space Grotesk", sans-serif;
		color: var(--accent);
		font-size: 10px;
		letter-spacing: 0.22em;
		line-height: 1.8;
		margin: 0 0 30px;
	}

	.text-link {
		font-family: "Space Grotesk", sans-serif;
		display: inline-flex;
		gap: 44px;
		align-items: center;
		font-size: 11px;
		letter-spacing: 0.06em;
		padding: 18px 0;
		border-bottom: 1px solid #ffffff50;
		margin-top: 24px;
		background: none;
		border-top: none;
		border-left: none;
		border-right: none;
		text-align: left;
	}

	.text-link span {
		font-size: 22px;
		color: var(--accent);
		transition: transform 0.3s;
	}

	.text-link:hover span {
		transform: translateY(4px);
	}

	.keywords {
		font-family: "Space Grotesk", sans-serif;
		display: flex;
		flex-wrap: wrap;
		gap: 10px 22px;
		max-width: 420px;
		margin-top: 32px;
		font-size: 10px;
		letter-spacing: 0.08em;
		color: var(--accent);
	}

	.keywords span:before {
		content: "+";
		margin-right: 10px;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 6px;
	}

	.paused *,
	.paused *:before,
	.paused *:after {
		animation-play-state: paused !important;
	}

	@keyframes camera {
		from {
			transform: scale(1.01) translateY(0);
		}
		to {
			transform: scale(1.09) translateY(-1%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*,
		*:before,
		*:after {
			animation: none !important;
			transition: none !important;
		}
	}

	@media (max-width: 800px) {
		h1 {
			font-size: clamp(37px, 7.5vw, 62px);
		}
		h2 {
			font-size: clamp(36px, 7vw, 58px);
		}
		.eyebrow {
			font-size: 8px;
			letter-spacing: 0.14em;
		}
	}
</style>
