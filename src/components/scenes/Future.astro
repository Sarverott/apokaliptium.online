---
import { media } from "../../lib/media.js";
import FilmTimeline from "../FilmTimeline.vue";
import Scene from "../Scene.astro";

const { chapter, timeline } = Astro.props;
---

<Scene chapter={chapter} variant="future">
	<p class="eyebrow">07 — NASZA WIZJA PRZYSZŁOŚCI</p>
	<h2>Od małych kroków.<br /><em>Do galaktycznej skali.</em></h2>
	<p>
		Cywilizacja typu III jest naszym dalekim horyzontem. Droga ku niej
		zaczyna się dziś: od wiedzy, narzędzi i współpracy.
	</p>
	<Fragment slot="after">
		<FilmTimeline steps={timeline} image={media("future.webp")} />
		<div class="future-bottom">
			<p>More minds.<br /><em>A kinder universe.</em></p>
			<a class="text-link" href="#opening">Odtwórz od początku <span>↥</span></a>
		</div>
		<footer>
			<a
				href="https://github.com/the-House-of-Anubis/Choirs-of-UCDI"
				target="_blank"
				rel="noopener noreferrer">Odkryj archiwum UCDI ↗</a
			><span>APOKALIPTIUM · INCEPTORIUM APOKRYF</span><small
				>Wizja przyszłości / ilustracje koncepcyjne</small
			>
		</footer>
	</Fragment>
</Scene>

<style>
	.future-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin: 55px 9% 80px;
	}

	.future-bottom p {
		font-size: clamp(28px, 4vw, 56px);
		line-height: 1.2;
		letter-spacing: -0.03em;
	}

	footer {
		font-family: "Space Grotesk", sans-serif;
		border-top: 1px solid #ffffff20;
		margin: 0 5% 0 9%;
		padding: 30px 0;
		display: flex;
		justify-content: space-between;
		gap: 25px;
		flex-wrap: wrap;
		font-size: 8px;
		letter-spacing: 0.12em;
		color: #959ea5;
	}

	footer a {
		color: var(--accent);
	}

	@media (max-width: 800px) {
		.future-bottom {
			display: block;
			margin: 30px 8% 60px;
		}
		.future-bottom .text-link {
			margin-top: 0;
		}
		footer {
			line-height: 1.8;
		}
	}
</style>
